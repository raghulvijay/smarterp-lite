# ─── SmartERP Lite — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# The app works with ZERO config (Mock AI + DummyJSON API out of the box).
# IMPORTANT: Never commit your actual .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────


# ─── Data API ─────────────────────────────────────────────────────────────────
# DummyJSON is the default free REST API (no authentication needed).
# Swap this URL to point to your own real backend when ready.
# https://dummyjson.com — free, reliable, 200+ products / 200+ users
VITE_API_BASE_URL=https://dummyjson.com


# ─── AI Tier 1: Gemini Direct (recommended for demos & interviews) ────────────
# Set your Google Gemini API key to unlock real AI across ALL features:
#   • AI Insights — executive summary, recommendations, action plan
#   • AI Global Search — natural language product filtering
#   • Revenue Forecast — AI trend analysis callout
#   • Anomaly Detection — root cause analysis per anomaly
#   • Restock Planner — AI-generated purchase order draft
#   • AI Chat Widget — ask anything about your ERP data
#
# Free tier (no credit card): https://aistudio.google.com/
#
# ⚠️  VITE_ variables are bundled into the JS and visible in DevTools.
#     Fine for demos and portfolio projects. For production, use Tier 2.
VITE_GEMINI_API_KEY=

# Gemini model to use (default: gemini-2.0-flash — fast, free tier)
# Options: gemini-2.0-flash | gemini-1.5-pro | gemini-1.5-flash
VITE_GEMINI_MODEL=gemini-2.0-flash


# ─── AI Tier 2: Backend Proxy (for production deployments) ───────────────────
# Leave VITE_GEMINI_API_KEY empty and set these to route AI calls
# through your own serverless function (Vercel, AWS Lambda, Cloudflare Worker).
# Your backend holds the secret key server-side.
#
# Expected contract:
#   POST VITE_AI_API_URL
#   Body:     { prompt: string, type?: string, question?: string }
#   Response: { summary, recommendations, actionPlan }  |  { answer }
VITE_AI_PROVIDER=mock
VITE_AI_API_URL=

# ─── AI Tier 3: Mock (default — zero config) ──────────────────────────────────
# When neither key above is set, the app uses built-in rule-based AI responses.
# All features remain functional — just with deterministic mock data instead of
# live Gemini responses. The current mode is shown in the AI Insights page header.
